@using TEFLY.ViewModels
@model ChildViewModel

<form asp-action="Create">
    <form asp-action="Create">

        <div class="mb-3">
            <label>Name</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Age</label>
            <input asp-for="Age" class="form-control" />
        </div>

        <div class="mb-3">
            <label>National ID</label>
            <input asp-for="NationalID" class="form-control" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="HasDiseases" class="form-check-input" />
            <label class="form-check-label">Has Diseases</label>
        </div>

        <div class="mb-3">
            <label>Diseases Description</label>
            <textarea asp-for="DiseasesDescription" class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-success">Save</button>

    </form>
</form>