@using TEFLY.ViewModels
@model IEnumerable<ChildViewModel>

<h2>Children</h2>
<a asp-action="Create" class="btn btn-primary">Add Child</a>

<table class="table">
    <tr><th>Name</th><th>Actions</th></tr>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>
                <a asp-action="Details" asp-route-id="@c.ChildID">Details</a> |
                <a asp-action="Edit" asp-route-id="@c.ChildID">Edit</a>
            </td>
            <td>
                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure?');">
                    <input type="hidden" name="id" value="@c.ChildID" />
                    <button class="btn btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
</table>