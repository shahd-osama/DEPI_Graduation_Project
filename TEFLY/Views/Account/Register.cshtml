@model TEFLY.ViewModels.RegisterViewModel


<h2>Register</h2>

<form asp-action="Register" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>
    <input asp-for="Name" placeholder="Full Name" />
    <span asp-validation-for="Name"></span>
    <br />

    <input asp-for="Email" placeholder="Email" />
    <span asp-validation-for="Email"></span>
    <br />

    <input asp-for="Phone" placeholder="Phone" />
    <span asp-validation-for="Phone"></span>
    <br />

    <input asp-for="NationalID" placeholder="National ID" />
    <br />

    <input asp-for="City" placeholder="City" />
    <br />

    <input asp-for="Address" placeholder="Address" />
    <br />

    <input asp-for="Age" placeholder="Age" />
    <br />

    <input asp-for="Password" type="password" placeholder="Password" />
    <span asp-validation-for="Password" class="text-danger"></span>
     <br />

    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
     <br />

    <button type="submit">Register</button>
</form>
