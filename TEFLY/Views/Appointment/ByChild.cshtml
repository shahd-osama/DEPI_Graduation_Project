@using TEFLY.ViewModels
@model IEnumerable<AppointmentViewModel>


<h2>Appointments</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<a asp-action="Book" asp-route-childId="@ViewBag.ChildID" class="btn btn-primary mb-3">
    Book New Appointment
</a>

@if (!Model.Any())
{
    <p>No appointments yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Date</td>
                    <td>@a.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
<script>
    setTimeout(function () {
        var msg = document.getElementById("successMsg");
        if (msg) {
            msg.style.transition = "opacity 0.5s";
            msg.style.opacity = "0";
        }
    }, 1000);
</script>
